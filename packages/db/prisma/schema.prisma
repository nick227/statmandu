generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / account identity
// User = login/identity. Profile = public app identity (username, avatar).
// PersonProfile (below) is a separate, claimable, sport-agnostic public
// entity — a User does not get one automatically at registration.
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  publishingApprovals Claim[] @relation("PublishingApprover")
  revokedClaims Claim[] @relation("ClaimRevoker")
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  storefront        Storefront?
  cardDesigns       CardTemplate[] @relation("CardDesignCreator")
  profile           Profile?
  sessions          Session[]
  createdPeople     PersonProfile[] @relation("CreatedPeople")
  claimedProfile    PersonProfile? @relation("ClaimedProfile")
  gameReporters     GameReporter[]
  follows           Follow[]
  reactions         Reaction[]
  disputesFiled     Dispute[]       @relation("DisputeSubmitter")
  disputesResolved  Dispute[]       @relation("DisputeResolver")
  claimsRequested   Claim[]         @relation("ClaimRequester")
  claimsReviewed    Claim[]         @relation("ClaimReviewer")
  articlesAuthored  Article[]       @relation("ArticleAuthor")
  articlesReviewed  Article[]       @relation("ArticleReviewer")
  mediaAssets       MediaAsset[]
  imageAssets       ImageAsset[]
  publishedCards    CardRelease[]  @relation("PublishedCards")
  cardTemplates     CardRelease[]  @relation("CreatedCardTemplates")
  cardSaves         CardSave[]
  ownedCardIssues   CardIssue[]     @relation("OwnedCardIssues")
  claimedCardIssues CardIssue[]     @relation("ClaimedCardIssues")
  cardDownloadEvents CardDownloadEvent[]
  adminActions      AdminAuditLog[] @relation("AdminActionActor")
  adminActionsAs    AdminAuditLog[] @relation("AdminActionSubject")
  importRuns        ImportRun[]

  @@index([createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  username    String   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Shared vocabulary
// ─────────────────────────────────────────────────────────────────────────

// Provenance ladder for any stat, profile field, or record. Drives the
// verification badge shown on public entity pages.
enum SourceStatus {
  SELF_REPORTED
  PLAYER_REPORTED
  SPECTATOR_REPORTED
  MULTI_SPECTATOR_CONFIRMED
  TEAM_MANAGER_ENTERED
  OFFICIAL_SCORER_RECORDED
  VERIFIED_TEAM_ACCOUNT
  ONLINE_SOURCE_IMPORTED
  PUBLIC_SOURCE_SCRAPED
  IN_DISPUTE
}

// One polymorphic target vocabulary reused by MediaAsset, Follow, Reaction,
// Dispute, FeedItem, and SourceReference — keeps target-type semantics
// consistent instead of re-declaring a near-identical enum per model.
enum EntityType {
  PLAYER
  TEAM
  GAME
  FEED_ITEM
  ATHLETE_PROFILE
  GAME_STAT_LINE
  GAME_EVENT
  PROFILE_FIELD
  SOURCE_REFERENCE
  PLAYER_SEASON_STAT
  TEAM_SEASON_STAT
  CARD_TEMPLATE
  CARD_DESIGN
  CARD_ISSUE
  ARTICLE
}

// ─────────────────────────────────────────────────────────────────────────
// Sport / organizational hierarchy
// ─────────────────────────────────────────────────────────────────────────

model Sport {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leagues League[]
  teams   Team[]
  players Player[]
  games   Game[]
}

model League {
  id        String   @id @default(cuid())
  sportId   String
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sport   Sport    @relation(fields: [sportId], references: [id])
  teams   Team[]
  seasons Season[]
  games   Game[]

  @@index([sportId])
}

model School {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]
}

model Season {
  id        String    @id @default(cuid())
  leagueId  String
  slug      String    @unique
  name      String
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  league            League             @relation(fields: [leagueId], references: [id])
  games             Game[]
  rosterMemberships RosterMembership[]
  playerSeasonStats PlayerSeasonStat[]
  teamSeasonStats   TeamSeasonStat[]

  @@index([leagueId])
}

model Team {
  id        String   @id @default(cuid())
  sportId   String
  leagueId  String
  schoolId  String?
  slug      String   @unique
  name      String
  city      String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sport             Sport              @relation(fields: [sportId], references: [id])
  league            League             @relation(fields: [leagueId], references: [id])
  school            School?            @relation(fields: [schoolId], references: [id])
  rosterMemberships RosterMembership[]
  gameTeams         GameTeam[]
  seasonStats       TeamSeasonStat[]
  gameReporters     GameReporter[]
  cardTemplates     CardRelease[]

  @@index([sportId])
  @@index([leagueId])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────────────────
// Athlete identity — public, claimable, sport-agnostic.
// A Player row is the sport-specific attachment of an PersonProfile
// (position, class year, jersey). One profile can have a Player row per
// sport in the future; MVP only ever creates one (basketball).
// ─────────────────────────────────────────────────────────────────────────

model PersonProfile {
  displayName     String       @default("")
  aliases         Json?
  createdByUserId String?
  createdByUser User? @relation("CreatedPeople", fields: [createdByUserId], references: [id])
  @@index([createdByUserId])
  @@map("AthleteProfile")
  id              String       @id @default(cuid())
  slug            String       @unique
  firstName       String       @default("")
  lastName        String       @default("")
  bio             String?
  hometown        String?
  avatarUrl       String?
  sourceStatus    SourceStatus @default(SELF_REPORTED)
  claimedByUserId String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  claimedByUser User?          @relation("ClaimedProfile", fields: [claimedByUserId], references: [id])
  players       Player[]
  claims        Claim[]
  cardTemplates CardRelease[]

  @@index([createdAt])
}

enum PlayerPosition {
  PG
  SG
  SF
  PF
  C
  GK
  DEF
  MID
  FWD
  QB
  RB
  WR
  TE
  OL
  DL
  LB
  CB
  S
  K
  P
  SINGLES
  DOUBLES
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

model Player {
  id               String          @id @default(cuid())
  athleteProfileId String
  sportId          String
  position         PlayerPosition?
  classYear        String?
  jerseyNumber     Int?
  heightInches     Int?
  status           PlayerStatus    @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  athleteProfile    PersonProfile     @relation(fields: [athleteProfileId], references: [id])
  sport             Sport              @relation(fields: [sportId], references: [id])
  rosterMemberships RosterMembership[]
  seasonStats       PlayerSeasonStat[]
  gameStatLines     GameStatLine[]
  gameEvents        GameEvent[]

  @@unique([athleteProfileId, sportId])
  @@index([sportId])
}

model RosterMembership {
  id           String    @id @default(cuid())
  playerId     String
  teamId       String
  seasonId     String
  jerseyNumber Int?
  isActive     Boolean   @default(true)
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, teamId, seasonId])
  @@index([teamId, seasonId])
}

// ─────────────────────────────────────────────────────────────────────────
// Games and live event capture
// Raw event log is never collapsed directly into final totals — see
// GameEvent → GameConsensusGroup → GameStatLine separation below.
// ─────────────────────────────────────────────────────────────────────────

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
  DISPUTED
}

model Game {
  id          String     @id @default(cuid())
  sportId     String
  leagueId    String?
  seasonId    String?
  scheduledAt DateTime
  venue       String?
  status      GameStatus @default(SCHEDULED)
  startedAt   DateTime?
  finalizedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sport           Sport                @relation(fields: [sportId], references: [id])
  league          League?              @relation(fields: [leagueId], references: [id])
  season          Season?              @relation(fields: [seasonId], references: [id])
  gameTeams       GameTeam[]
  reporters       GameReporter[]
  events          GameEvent[]
  consensusGroups GameConsensusGroup[]
  statLines       GameStatLine[]
  gameReactions   GameReaction[]
  cardTemplates   CardRelease[]

  @@index([sportId])
  @@index([scheduledAt])
  @@index([status])
}

model GameTeam {
  id         String  @id @default(cuid())
  gameId     String
  teamId     String
  isHome     Boolean
  finalScore Int?

  game Game @relation(fields: [gameId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([gameId, teamId])
  @@index([teamId])
}

enum GameReporterRole {
  ADMIN_OWNER
  OFFICIAL_SCORER
  TEAM_SCORER
  BROADCASTER
  CONTRIBUTOR
  SPECTATOR_REPORTER
  VIEWER
}

model GameReporter {
  id        String           @id @default(cuid())
  gameId    String
  userId    String
  teamId    String?
  role      GameReporterRole
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  game       Game        @relation(fields: [gameId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  gameEvents GameEvent[]

  @@unique([gameId, userId])
  @@index([gameId, role])
}

enum GameEventType {
  FT_MADE
  FT_MISS
  FG2_MADE
  FG2_MISS
  FG3_MADE
  FG3_MISS
  REBOUND_OFF
  REBOUND_DEF
  ASSIST
  STEAL
  BLOCK
  TURNOVER
  FOUL
  SUBSTITUTION_IN
  SUBSTITUTION_OUT
  SOCCER_GOAL
  SOCCER_ASSIST
  SOCCER_SHOT
  SOCCER_SAVE
  SOCCER_YELLOW_CARD
  SOCCER_RED_CARD
  FOOTBALL_PASS_TD
  FOOTBALL_RUSH_TD
  FOOTBALL_REC_TD
  FOOTBALL_FIELD_GOAL_MADE
  FOOTBALL_EXTRA_POINT_MADE
  FOOTBALL_SACK
  FOOTBALL_INTERCEPTION
  TENNIS_MATCH_WIN
  TENNIS_MATCH_LOSS
  TENNIS_SET_WIN
  TENNIS_SET_LOSS
  TENNIS_ACE
  TENNIS_DOUBLE_FAULT
}

enum GameEventStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFLICTING
  CORRECTED
  DISPUTED
  FINALIZED
}

model GameEvent {
  id               String          @id @default(cuid())
  gameId           String
  reporterId       String
  playerId         String?
  teamId           String?
  type             GameEventType
  payload          Json?
  clientTimestamp  DateTime
  deviceId         String?
  status           GameEventStatus @default(PENDING)
  consensusGroupId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  game           Game                @relation(fields: [gameId], references: [id])
  reporter       GameReporter        @relation(fields: [reporterId], references: [id])
  player         Player?             @relation(fields: [playerId], references: [id])
  consensusGroup GameConsensusGroup? @relation(fields: [consensusGroupId], references: [id])

  @@index([gameId, status])
  @@index([gameId, playerId])
  @@index([consensusGroupId])
}

enum ConsensusStatus {
  PENDING
  CONFIRMED
  CONFLICTING
  RESOLVED
}

model GameConsensusGroup {
  id              String          @id @default(cuid())
  gameId          String
  groupKey        String
  status          ConsensusStatus @default(PENDING)
  resolvedEventId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  game   Game        @relation(fields: [gameId], references: [id])
  events GameEvent[]

  @@index([gameId, status])
}

// Resolved, display-ready box score line — produced by end-game
// reconciliation. Never written directly; only derived from GameEvents.
model GameStatLine {
  id             String       @id @default(cuid())
  gameId         String
  playerId       String
  teamId         String
  points         Int          @default(0)
  offRebounds    Int          @default(0)
  defRebounds    Int          @default(0)
  assists        Int          @default(0)
  steals         Int          @default(0)
  blocks         Int          @default(0)
  turnovers      Int          @default(0)
  fouls          Int          @default(0)
  fgMade         Int          @default(0)
  fgAttempted    Int          @default(0)
  threeMade      Int          @default(0)
  threeAttempted Int          @default(0)
  ftMade         Int          @default(0)
  ftAttempted    Int          @default(0)
  stats          Json?
  sourceStatus   SourceStatus @default(OFFICIAL_SCORER_RECORDED)
  disputeNote    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  game   Game   @relation(fields: [gameId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([gameId, playerId])
  @@index([teamId])
}

model PlayerSeasonStat {
  id             String   @id @default(cuid())
  playerId       String
  seasonId       String
  gamesPlayed    Int      @default(0)
  points         Int      @default(0)
  offRebounds    Int      @default(0)
  defRebounds    Int      @default(0)
  assists        Int      @default(0)
  steals         Int      @default(0)
  blocks         Int      @default(0)
  turnovers      Int      @default(0)
  fouls          Int      @default(0)
  fgMade         Int      @default(0)
  fgAttempted    Int      @default(0)
  threeMade      Int      @default(0)
  threeAttempted Int      @default(0)
  ftMade         Int      @default(0)
  ftAttempted    Int      @default(0)
  stats          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, seasonId])
}

model TeamSeasonStat {
  id            String   @id @default(cuid())
  teamId        String
  seasonId      String
  wins          Int      @default(0)
  losses        Int      @default(0)
  pointsFor     Int      @default(0)
  pointsAgainst Int      @default(0)
  stats         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([teamId, seasonId])
}

// Provider-neutral import ledger. Imported aggregates intentionally remain
// separate from reporter-authored GameEvent and reconciled GameStatLine data.
enum ImportProvider {
  API_SPORTS_BASKETBALL
}

enum ImportRunStatus {
  PREVIEWING
  READY
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum ImportStatAvailability {
  AVAILABLE
  UNSUPPORTED
  NOT_AVAILABLE
}

enum ImportRecordAction {
  CREATE
  UPDATE
  UNCHANGED
  CONFLICT
  SKIP
  ERROR
}

enum ImportEntityType {
  LEAGUE
  SEASON
  TEAM
  PLAYER
  GAME
  STANDING
  STAT_LINE
}

model ExternalEntityMapping {
  id           String           @id @default(cuid())
  provider     ImportProvider
  entityType   ImportEntityType
  externalId   String
  localId      String
  externalName String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([provider, entityType, externalId])
  @@index([entityType, localId])
}

model ImportRun {
  id             String          @id @default(cuid())
  provider       ImportProvider
  status         ImportRunStatus @default(PREVIEWING)
  requestedById  String
  leagueExternalId String
  seasonExternalId String
  scopes         Json
  options        Json?
  capabilities   Json?
  estimatedRequestCost Int       @default(0)
  detailRequestCap Int            @default(10)
  detailRequestsCompleted Int     @default(0)
  requestedCount Int             @default(0)
  createdCount   Int             @default(0)
  updatedCount   Int             @default(0)
  unchangedCount Int             @default(0)
  conflictCount  Int             @default(0)
  errorCount     Int             @default(0)
  errorSummary   String?         @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  requestedBy User                @relation(fields: [requestedById], references: [id])
  records     ImportRecord[]
  snapshots   ImportRawSnapshot[]

  @@index([provider, createdAt])
  @@index([requestedById])
}

model ImportRecord {
  id            String             @id @default(cuid())
  importRunId   String
  entityType    ImportEntityType
  externalId    String
  externalName  String?
  action        ImportRecordAction
  localId       String?
  normalized    Json
  differences   Json?
  resolution    Json?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@unique([importRunId, entityType, externalId])
  @@index([importRunId, action])
}

model ImportRawSnapshot {
  id          String         @id @default(cuid())
  importRunId String
  provider    ImportProvider
  requestKey  String
  endpoint    String
  parameters  Json
  payload     Json
  payloadHash String
  fetchedAt   DateTime       @default(now())
  expiresAt   DateTime

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@unique([importRunId, requestKey])
  @@index([provider, requestKey, expiresAt])
}

model ImportRequestLog {
  id             String         @id @default(cuid())
  provider       ImportProvider
  requestKey     String
  endpoint       String
  responseStatus Int
  cacheHit       Boolean        @default(false)
  quotaLimit     Int?
  quotaRemaining Int?
  requestedAt    DateTime       @default(now())
  durationMs     Int

  @@index([provider, requestedAt])
}

model ImportedStatLine {
  id             String           @id @default(cuid())
  provider       ImportProvider
  externalId     String
  sportSlug      String
  leagueId       String?
  seasonId       String?
  gameId         String?
  teamId         String?
  playerId       String?
  subjectType    ImportEntityType
  statKind       String
  availability   ImportStatAvailability @default(AVAILABLE)
  stats          Json
  sourceUpdatedAt DateTime?
  importedAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([provider, externalId])
  @@index([gameId, teamId])
  @@index([seasonId, teamId])
}

// ─────────────────────────────────────────────────────────────────────────
// Media (YouTube-only for MVP)
// ─────────────────────────────────────────────────────────────────────────

enum MediaAssetType {
  YOUTUBE
}

enum ImageAssetUsage {
  AVATAR
  LOGO
  HERO
  EVIDENCE
  GALLERY
}

enum ImageStorageProvider {
  LOCAL
  R2
  RAILWAY_VOLUME
}

model MediaAsset {
  id               String         @id @default(cuid())
  type             MediaAssetType @default(YOUTUBE)
  youtubeVideoId   String
  title            String?
  targetType       EntityType
  targetId         String
  uploadedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  uploadedByUser User? @relation(fields: [uploadedByUserId], references: [id])

  @@index([targetType, targetId])
}

model ImageAsset {
  visibility       CardVisibility @default(PUBLIC)
  id               String               @id @default(cuid())
  targetType       EntityType
  targetId         String
  usage            ImageAssetUsage
  storageProvider  ImageStorageProvider @default(LOCAL)
  objectKey        String
  url              String
  originalFilename String?
  contentType      String
  byteSize         Int
  width            Int?
  height           Int?
  uploadedByUserId String?
  createdAt        DateTime             @default(now())
  deletedAt        DateTime?

  uploadedByUser User?          @relation(fields: [uploadedByUserId], references: [id])
  cardFrontOf    CardRelease[] @relation("CardFrontImage")
  cardSourceOf   CardRelease[] @relation("CardSourceImage")

  @@index([targetType, targetId, usage])
  @@index([createdAt])
  @@index([objectKey])
}

// ─────────────────────────────────────────────────────────────────────────
// Statman Cards — internally editioned athlete trading cards
// ─────────────────────────────────────────────────────────────────────────

enum CardType {
  PROFILE
  BIG_GAME
  MILESTONE
  SEASON
  HIGHLIGHT
}

enum CardTemplateStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  ARCHIVED
  FAILED
}

enum CardVisibility {
  PRIVATE
  PUBLIC
}

enum CardEditionMode {
  UNLIMITED
  LIMITED
  ONE_OF_ONE
}

enum CardIssueStatus {
  CLAIMED
  DOWNLOADED
  REVOKED
}

enum CardGenerationProvider {
  STUB
  GEMINI
}

enum CardGenerationStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

// Which in-app surface a card download was initiated from — "waste not
// want not" retention means an athlete can accumulate many private
// generations, so knowing where their *public* cards actually get
// downloaded from is the useful signal, not IP geolocation (deliberately
// out of scope, see plan doc).
enum CardDownloadContext {
  PROFILE
  HOME
  EXPLORE
  CARD_STUDIO
  SHARED_LINK
  DIRECT
}

enum CardPublicationType {
  COMMUNITY
  OFFICIAL
}

model CardTemplate {
  id String @id @default(cuid())
  createdByUserId String
  title String
  revision Int @default(1)
  rendererVersion String @default("rdc-composition-v1")
  compositionJson Json
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdByUser User @relation("CardDesignCreator", fields: [createdByUserId], references: [id])
  releases CardRelease[]

  @@map("CardDesign")
  @@index([createdByUserId, updatedAt])
}

model Storefront {
  id String @id @default(cuid())
  userId String @unique
  description String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  releases CardRelease[]
}

model CardRelease {
  authorizationClaimId String?
  authorizationClaim Claim? @relation(fields: [authorizationClaimId], references: [id], onDelete: Restrict)
  attestationVersion Int?
  manifestJson Json?
  manifestHash String?
  manifestSignature String? @db.Text
  signingKeyId String?
  @@index([authorizationClaimId])
  @@map("CardTemplate")
  templateId String?
  templateRevision Int?
  templateSnapshotJson Json?
  template CardTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  storefrontId String?
  storefront Storefront? @relation(fields: [storefrontId], references: [id], onDelete: Restrict)
  releaseRequestId String?
  releaseRequestHash String?
  @@unique([createdByUserId, releaseRequestId], map: "CardTemplate_creator_releaseRequest_key")
  @@index([templateId])
  @@index([storefrontId, status, visibility, publishedAt])
  publicationType CardPublicationType @default(COMMUNITY)
  publishedByUserId String?
  publishedByUser User? @relation("PublishedCards", fields: [publishedByUserId], references: [id])
  contentSnapshotJson Json?
  @@index([publishedByUserId])
  id                 String             @id @default(cuid())
  athleteProfileId   String
  teamId             String?
  gameId             String?
  createdByUserId    String
  title              String
  cardType           CardType
  stylePreset        String
  status             CardTemplateStatus @default(DRAFT)
  visibility         CardVisibility     @default(PRIVATE)
  editionMode        CardEditionMode    @default(UNLIMITED)
  editionSize        Int?
  issuedCount        Int                @default(0)
  frontImageAssetId  String?
  sourceImageAssetId String?
  statsSnapshotJson  Json
  originHash         String?
  // Client-supplied idempotency key for batch generation — a retried or
  // double-tapped POST /cards/generate-batch with the same key returns the
  // existing batch instead of creating a second one. Null for cards made
  // through the single-card manual builder.
  batchRequestId     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  publishedAt        DateTime?

  athleteProfile   PersonProfile      @relation(fields: [athleteProfileId], references: [id])
  team             Team?               @relation(fields: [teamId], references: [id])
  game             Game?               @relation(fields: [gameId], references: [id])
  createdByUser    User                @relation("CreatedCardTemplates", fields: [createdByUserId], references: [id])
  frontImageAsset  ImageAsset?         @relation("CardFrontImage", fields: [frontImageAssetId], references: [id])
  sourceImageAsset ImageAsset?         @relation("CardSourceImage", fields: [sourceImageAssetId], references: [id])
  issues           CardIssue[]
  generationJobs   CardGenerationJob[]
  downloadEvents   CardDownloadEvent[]
  saves            CardSave[]

  @@index([athleteProfileId, status])
  @@index([visibility, status, publishedAt])
  @@index([createdByUserId])
  @@index([athleteProfileId, batchRequestId])
  generationKey String? @unique
}

model CardIssue {
  id              String          @id @default(cuid())
  releaseId  String @map("cardTemplateId")
  issueNumber     Int?
  ownerUserId     String?
  claimedByUserId String?
  claimedAt       DateTime?
  downloadedAt    DateTime?
  issueHash       String
  status          CardIssueStatus @default(CLAIMED)
  createdAt       DateTime        @default(now())

  release   CardRelease        @relation(fields: [releaseId], references: [id], map: "CardIssue_cardTemplateId_fkey")
  ownerUser      User?               @relation("OwnedCardIssues", fields: [ownerUserId], references: [id])
  claimedByUser  User?               @relation("ClaimedCardIssues", fields: [claimedByUserId], references: [id])
  downloadEvents CardDownloadEvent[]

  @@unique([releaseId, issueNumber], map: "CardIssue_cardTemplateId_issueNumber_key")
  @@unique([issueHash])
  @@index([claimedByUserId, createdAt])
}

model CardDownloadEvent {
  id                 String              @id @default(cuid())
  releaseId     String @map("cardTemplateId")
  cardIssueId        String
  downloadedByUserId String
  context            CardDownloadContext @default(DIRECT)
  createdAt          DateTime            @default(now())

  release     CardRelease @relation(fields: [releaseId], references: [id], map: "CardDownloadEvent_cardTemplateId_fkey")
  cardIssue        CardIssue    @relation(fields: [cardIssueId], references: [id])
  downloadedByUser User         @relation(fields: [downloadedByUserId], references: [id])

  @@index([releaseId, createdAt], map: "CardDownloadEvent_cardTemplateId_createdAt_idx")
  @@index([downloadedByUserId, createdAt])
}

// Lightweight save/collect — deliberately a dedicated model with a direct
// FK, not the polymorphic Follow/Reaction EntityType pattern, since saves
// are single-purpose (cards only), unlike Follow/Reaction which span
// multiple target kinds. The prerequisite for a "Collections" surface
// (saved + claimed cards) — see Follow for the equivalent toggle shape.
model CardSave {
  id             String   @id @default(cuid())
  userId         String
  releaseId String @map("cardTemplateId")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  release CardRelease @relation(fields: [releaseId], references: [id], map: "CardSave_cardTemplateId_fkey")

  @@unique([userId, releaseId], map: "CardSave_userId_cardTemplateId_key")
  @@index([releaseId], map: "CardSave_cardTemplateId_idx")
}

model CardGenerationJob {
  id             String                 @id @default(cuid())
  releaseId String @map("cardTemplateId")
  provider       CardGenerationProvider @default(STUB)
  status         CardGenerationStatus   @default(QUEUED)
  inputJson      Json
  outputJson     Json?
  error          String?
  // Real retry state for the reconciliation sweep — a stuck job gets this
  // incremented and re-run in place rather than spawning a new job row.
  attempt        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  release CardRelease @relation(fields: [releaseId], references: [id], map: "CardGenerationJob_cardTemplateId_fkey")

  @@index([releaseId, createdAt], map: "CardGenerationJob_cardTemplateId_createdAt_idx")
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Source tracking, verification, disputes, claims
// ─────────────────────────────────────────────────────────────────────────

enum ReferenceSourceType {
  VERIFIED_TEAM_ACCOUNT
  TEAM_MANAGER
  OFFICIAL_SCORER
  PLAYER_REPORT
  SPECTATOR_REPORT
  MULTI_SPECTATOR_REPORT
  TEAM_WEBSITE
  LEAGUE_WEBSITE
  MAXPREPS
  HUDL
  YOUTUBE
  NEWS_ARTICLE
  BOXSCORE_PDF
  SCOREBOOK_PHOTO
  PUBLIC_SCRAPE
  OTHER
}

model SourceReference {
  id         String              @id @default(cuid())
  targetType EntityType
  targetId   String
  sourceType ReferenceSourceType
  url        String?
  label      String?
  importedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([targetType, targetId])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id                String        @id @default(cuid())
  targetType        EntityType
  targetId          String
  fieldName         String?
  submittedByUserId String
  description       String        @db.Text
  proposedValue     String?
  status            DisputeStatus @default(OPEN)
  resolutionNote    String?
  resolvedByUserId  String?
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  submittedByUser User  @relation("DisputeSubmitter", fields: [submittedByUserId], references: [id])
  resolvedByUser  User? @relation("DisputeResolver", fields: [resolvedByUserId], references: [id])

  @@index([targetType, targetId])
  @@index([status])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model Claim {
  publishingApprovedAt DateTime?
  publishingApprovedByUserId String?
  publishingApprovedByUser User? @relation("PublishingApprover", fields: [publishingApprovedByUserId], references: [id])
  revokedAt DateTime?
  revokedByUserId String?
  revokedByUser User? @relation("ClaimRevoker", fields: [revokedByUserId], references: [id])
  revocationReason String? @db.Text
  authorizedReleases CardRelease[]
  id                String      @id @default(cuid())
  athleteProfileId  String
  requestedByUserId String
  verificationNote  String?
  status            ClaimStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  athleteProfile  PersonProfile @relation(fields: [athleteProfileId], references: [id])
  requestedByUser User           @relation("ClaimRequester", fields: [requestedByUserId], references: [id])
  reviewedByUser  User?          @relation("ClaimReviewer", fields: [reviewedByUserId], references: [id])

  @@index([athleteProfileId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Content — sports articles. Submittable by any user, gated behind admin
// approval before becoming publicly readable — same PENDING/APPROVED/
// REJECTED review shape as Claim above, plus a DRAFT state Claim doesn't
// need (a claim is submitted complete; an article is authored over time).
// ─────────────────────────────────────────────────────────────────────────

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model Article {
  id             String        @id @default(cuid())
  authorUserId   String
  title          String
  body           String        @db.Text
  // JSON string array, not a MySQL scalar list (Prisma/MySQL has no native
  // array type — see the `stats` Json fields elsewhere in this schema for
  // the same fallback).
  keywords       Json?
  thumbnailUrl   String?
  status         ArticleStatus @default(DRAFT)
  rejectionNote  String?
  reviewedByUserId String?
  reviewedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  authorUser     User  @relation("ArticleAuthor", fields: [authorUserId], references: [id])
  reviewedByUser User? @relation("ArticleReviewer", fields: [reviewedByUserId], references: [id])

  @@index([status, publishedAt])
  @@index([authorUserId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Social layer — follow, react, feed
// ─────────────────────────────────────────────────────────────────────────

model Follow {
  id         String     @id @default(cuid())
  followerId String
  targetType EntityType
  targetId   String
  createdAt  DateTime   @default(now())

  follower User @relation(fields: [followerId], references: [id])

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
}

enum ReactionType {
  LIKE
  FIRE
  CLAP
}

model Reaction {
  id         String       @id @default(cuid())
  userId     String
  targetType EntityType
  targetId   String
  type       ReactionType @default(LIKE)
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// Ephemeral reactions specifically for live game broadcasts (spamming allowed, no user auth required)
model GameReaction {
  id        String       @id @default(cuid())
  gameId    String
  deviceId  String
  type      ReactionType
  createdAt DateTime     @default(now())

  game Game @relation(fields: [gameId], references: [id])

  @@index([gameId, createdAt])
}

enum FeedItemType {
  GAME_FINAL
  STAT_MILESTONE
  MEDIA_ADDED
  PLAYER_JOINED_TEAM
  PROFILE_CLAIMED
  DISPUTE_RESOLVED
  CARD_PUBLISHED
  CARD_CLAIMED
  CARD_DOWNLOADED
  ARTICLE_PUBLISHED
}

model FeedItem {
  id         String       @id @default(cuid())
  type       FeedItemType
  targetType EntityType
  targetId   String
  summary    String
  occurredAt DateTime
  createdAt  DateTime     @default(now())

  @@index([occurredAt])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────────────────────────────
// Admin audit log — accountability for privileged mutations and impersonation
// ─────────────────────────────────────────────────────────────────────────

enum AdminAuditAction {
  ADMIN_IMPERSONATE_SET
  ADMIN_IMPERSONATE_CLEAR
  ADMIN_BULK_CREATE_PLAYERS
  ADMIN_BULK_ADD_ROSTER
  ADMIN_CREATE_FEED_ITEM
  ADMIN_MUTATION
}

model AdminAuditLog {
  id            String           @id @default(cuid())
  actorUserId   String
  subjectUserId String?
  action        AdminAuditAction @default(ADMIN_MUTATION)
  method        String
  path          String
  targetType    EntityType?
  targetId      String?
  note          String?
  diffJson      Json?
  requestId     String?
  createdAt     DateTime         @default(now())

  actorUser   User  @relation("AdminActionActor", fields: [actorUserId], references: [id])
  subjectUser User? @relation("AdminActionSubject", fields: [subjectUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([targetType, targetId])
}
