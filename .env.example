# Database
DATABASE_URL=mysql://statman:statman_dev_password@localhost:3306/statman_dev
SEED_SCENARIO=full
SEED_REFERENCE_DATE=2026-07-01
# Fail-closed escape hatch for an intentional administrative seed only.
# Never commit this as true and never use it without verifying the printed target.
ALLOW_UNSAFE_SEED=false

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3001

# Image storage
# Localhost stores under IMAGE_STORAGE_DIR. Railway can set RAILWAY_VOLUME_MOUNT_PATH
# for fallback volume storage. Set IMAGE_STORAGE_DRIVER=r2 plus the R2 values to
# prefer Cloudflare R2 and fall back to the volume/local path if upload fails.
IMAGE_STORAGE_DIR=uploads/images
IMAGE_UPLOAD_MAX_BYTES=5242880
IMAGE_STORAGE_DRIVER=local
RAILWAY_VOLUME_MOUNT_PATH=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Card image generation (Google Gemini 2.5 Flash Image)
# Unset -> falls back to the stub generator (no real images, dev/test never
# hard-fails on a missing key) — same graceful-fallback pattern as R2 above.
GEMINI_API_KEY=
CARD_GENERATION_CONCURRENCY=2
CARD_GENERATION_SHUTDOWN_TIMEOUT_MS=15000

# Web (later — Expo/PWA client)
# Required for EAS preview/production builds and must be HTTPS there.
# Development may omit this to use http://localhost:3001.
EXPO_PUBLIC_API_URL=http://localhost:3001
API_SPORTS_KEY=
API_SPORTS_DAILY_LIMIT=100
API_SPORTS_MINUTE_LIMIT=10
API_SPORTS_CACHE_TTL_MS=21600000
API_SPORTS_DETAIL_REQUESTS_PER_RUN=10
API_SPORTS_PLAN=free
# Free plans require one game per detailed-stat request; paid plans may allow up to 20.
API_SPORTS_DETAIL_BATCH_SIZE=1
